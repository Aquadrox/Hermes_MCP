# hermes-nas — configuration du gestionnaire de fichiers (NAS)
#
# Emplacement : /etc/hermes-nas/hermes-nas.env (root:hermes-nas, mode 0640)
# Après chaque modification :  sudo systemctl restart hermes-nas
# Vérification :               sudo hermes-ngrok-admin nas check
#
# Le NAS n'écoute que sur 127.0.0.1 et n'a aucun accès réseau : on n'y accède que par le
# tunnel ouvert par Hermes (outil nas_open, avec un code MFA).

# Dossier partagé. Pour le changer, relancer l'installeur avec --nas-dir (droits et
# sandbox systemd sont générés pour ce chemin).
HERMES_NAS_ROOT=/var/MonNAS

# Nom affiché dans l'interface.
HERMES_NAS_TITLE=MonNAS

# Port local (socket systemd). Doit rester égal à HERMES_NGROK_NAS_PORT : relancer
# l'installeur après l'avoir changé.
HERMES_NAS_PORT=8766

# Clé d'administration partagée avec le serveur MCP (générée par l'installeur, identique à
# HERMES_NGROK_NAS_ACCESS_KEY) : santé et remise des identifiants du tunnel, jamais l'accès
# aux fichiers. Ne pas la communiquer.
HERMES_NAS_ACCESS_KEY=

# Taille maximale d'un fichier envoyé (ex. 512M, 10G).
HERMES_NAS_MAX_UPLOAD=10G

# Arrêt automatique de l'application après cette durée sans requête (0 = jamais).
# Elle redémarre toute seule à la connexion suivante.
HERMES_NAS_IDLE_EXIT=10m

# Journal d'audit (envois, téléchargements, dossiers créés, accès refusés).
HERMES_NAS_STATE_DIR=/var/lib/hermes-nas

HERMES_NAS_TIMEZONE=Europe/Paris
#HERMES_NAS_LOG_LEVEL=INFO
