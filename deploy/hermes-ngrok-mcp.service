[Unit]
Description=Hermes ngrok MCP server (on-demand tunnels protected by TOTP)
Documentation=https://github.com/Aquadrox/Hermes_MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=hermes-ngrok
Group=hermes-ngrok
EnvironmentFile=/etc/hermes-ngrok-mcp/hermes-ngrok-mcp.env
ExecStart=/opt/hermes-ngrok-mcp/venv/bin/hermes-ngrok-mcp serve --transport http
Restart=on-failure
RestartSec=5s
# Leaves time to close open tunnels and notify the user on Telegram.
TimeoutStopSec=60s

# MFA secret and lockout state: /var/lib/hermes-ngrok-mcp, readable by the service user only.
StateDirectory=hermes-ngrok-mcp
StateDirectoryMode=0700
UMask=0077

# --- Sandboxing (check with: systemd-analyze security hermes-ngrok-mcp) ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
# AF_NETLINK: used by glibc getaddrinfo() to look up local interfaces.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute is deliberately not set: native Python extensions may need W+X pages.

[Install]
WantedBy=multi-user.target
