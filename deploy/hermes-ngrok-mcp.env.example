# hermes-ngrok-mcp — configuration du service
#
# Emplacement : /etc/hermes-ngrok-mcp/hermes-ngrok-mcp.env (root:hermes-ngrok, mode 0640)
# Après chaque modification :  sudo systemctl restart hermes-ngrok-mcp
# Vérification :               sudo hermes-ngrok-admin check
#
# Syntaxe : une variable par ligne, sans commentaire en fin de ligne.
# Durées : en secondes ou au format 45s, 10m, 1h30m.

# ---------------------------------------------------------------------------
# ngrok (obligatoire)
# ---------------------------------------------------------------------------
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Domaine réservé pour les tunnels HTTP (optionnel). Sur le plan gratuit, laisser
# vide : ngrok utilise automatiquement le domaine de développement du compte.
#HERMES_NGROK_DOMAIN=mon-domaine.ngrok-free.app

# ---------------------------------------------------------------------------
# Notifications Telegram (recommandé)
# ---------------------------------------------------------------------------
# Le même bot que Hermes. Pour une conversation privée, le chat id est ton user id
# Telegram (voir TELEGRAM_ALLOWED_USERS dans ~/.hermes/.env).
# Sert aussi à t'envoyer directement le QR code MFA et les mots de passe des
# tunnels, sans qu'ils passent par le modèle de langage.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Cycle de vie des tunnels
# ---------------------------------------------------------------------------
# Fermeture automatique sans activité (0 = jamais).
HERMES_NGROK_IDLE_TIMEOUT=10m
# Durée de vie maximale d'un tunnel (0 = illimitée).
HERMES_NGROK_MAX_LIFETIME=20m
# Alerte Telegram envoyée ce délai avant l'expiration (20m - 5m = alerte à 15 min).
HERMES_NGROK_EXPIRY_WARNING=5m
# Temps ajouté par chaque prolongation (un nouveau code MFA est exigé).
HERMES_NGROK_EXTENSION=20m
# Nombre maximal de tunnels simultanés (plan gratuit ngrok : 1 tunnel HTTP à la fois).
HERMES_NGROK_MAX_TUNNELS=3

# ---------------------------------------------------------------------------
# Ce qui peut être exposé
# ---------------------------------------------------------------------------
# Hôte local vers lequel les tunnels redirigent.
#HERMES_NGROK_TARGET_HOST=127.0.0.1
# Ports autorisés / interdits, ex. 80,443,8000-8999. Le port du MCP lui-même est
# toujours interdit.
#HERMES_NGROK_ALLOWED_PORTS=1-65535
#HERMES_NGROK_DENIED_PORTS=

# ---------------------------------------------------------------------------
# Protection des URL HTTP
# ---------------------------------------------------------------------------
# Identifiant + mot de passe aléatoires générés pour chaque tunnel HTTP.
HERMES_NGROK_BASIC_AUTH=true
#HERMES_NGROK_BASIC_AUTH_USER=hermes
# Autoriser un tunnel HTTP sans mot de passe quand tu le demandes explicitement.
#HERMES_NGROK_ALLOW_UNPROTECTED_HTTP=true
# false : le mot de passe t'est envoyé uniquement par Telegram, jamais à l'agent.
#HERMES_NGROK_SHARE_CREDENTIALS_WITH_AGENT=false

# ---------------------------------------------------------------------------
# MFA (TOTP — Proton Authenticator ou toute application compatible)
# ---------------------------------------------------------------------------
HERMES_NGROK_STATE_DIR=/var/lib/hermes-ngrok-mcp
#HERMES_NGROK_MFA_ISSUER="Hermes ngrok"
#HERMES_NGROK_MFA_ACCOUNT=hermes@mon-vps
# Verrouillage après N codes faux sur la fenêtre donnée.
#HERMES_NGROK_MFA_MAX_FAILURES=5
#HERMES_NGROK_MFA_FAILURE_WINDOW=5m
#HERMES_NGROK_MFA_LOCKOUT=15m
# Si Telegram est indisponible, autoriser l'envoi du QR code via l'agent.
#HERMES_NGROK_MFA_ALLOW_INLINE_ENROLLMENT=true

# ---------------------------------------------------------------------------
# Serveur MCP (accès local de Hermes)
# ---------------------------------------------------------------------------
HERMES_NGROK_HOST=127.0.0.1
HERMES_NGROK_PORT=8765
# Jeton partagé avec Hermes (généré par l'installeur ; même valeur que
# HERMES_NGROK_MCP_TOKEN dans ~/.hermes/.env).
HERMES_NGROK_API_TOKEN=

# ---------------------------------------------------------------------------
# Présentation
# ---------------------------------------------------------------------------
HERMES_NGROK_LANGUAGE=fr
HERMES_NGROK_TIMEZONE=Europe/Paris
#HERMES_NGROK_LOG_LEVEL=INFO
